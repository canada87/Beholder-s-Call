# Copy to .env and fill in the values

# Must match POSTGRES_PASSWORD in docker-compose
DB_PASSWORD=BeHoldersPass2026

# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=replace-with-random-secret

# Your server URL (e.g. https://yourdomain.com or http://IP)
NEXTAUTH_URL=http://localhost

# Admin account created automatically on first startup
ADMIN_EMAIL=admin@beholders.call
ADMIN_PASSWORD=ChangeMe123!
# ADMIN_USERNAME is optional — defaults to the part before @ in ADMIN_EMAIL
